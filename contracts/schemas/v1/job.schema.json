{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karrierekrake.local/contracts/v1/job.schema.json",
  "title": "Job",
  "description": "Discovered vacancy. Maps to core.models.Job. Desktop is typically authoritative for discovery.",
  "type": "object",
  "required": ["contract_version", "schema_id", "id"],
  "additionalProperties": true,
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "schema_id": { "const": "karrierekrake.job" },
    "id": { "type": "string" },
    "source": { "type": "string" },
    "source_job_id": { "type": "string" },
    "title": { "type": "string" },
    "company": { "type": "string" },
    "description": { "type": "string" },
    "city": { "type": "string" },
    "postal_code": { "type": "string" },
    "address": { "type": "string" },
    "country_code": { "$ref": "common.schema.json#/$defs/country_code" },
    "latitude": { "type": ["number", "null"] },
    "longitude": { "type": ["number", "null"] },
    "distance_km": { "type": ["number", "null"] },
    "remote_type": { "type": "string" },
    "employment_type": { "type": "string" },
    "salary_min": { "type": ["number", "null"] },
    "salary_max": { "type": ["number", "null"] },
    "salary_text": { "type": "string" },
    "published_at": { "$ref": "common.schema.json#/$defs/iso8601_or_empty" },
    "discovered_at": { "$ref": "common.schema.json#/$defs/iso8601_or_empty" },
    "url": { "type": "string" },
    "application_url": { "type": "string" },
    "ats_type": { "type": "string" },
    "match_score": { "type": "integer" },
    "match_reasons": { "$ref": "common.schema.json#/$defs/string_list" },
    "rejection_reasons": { "$ref": "common.schema.json#/$defs/string_list" },
    "status": { "type": "string" },
    "duplicate_of": { "type": ["string", "null"] },
    "alt_sources": { "$ref": "common.schema.json#/$defs/string_list" },
    "run_id": { "type": "string" },
    "ranking_version": { "type": "string" }
  }
}
